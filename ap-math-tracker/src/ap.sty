% Shared style for AP Math Tracker course documents
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ap}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{mathpazo}
\RequirePackage[scaled=0.92]{helvet}
\RequirePackage[a4paper,margin=2cm,top=2.2cm,bottom=2.2cm,headheight=14pt]{geometry}
\RequirePackage{amsmath,amssymb}
\RequirePackage{xcolor}
\RequirePackage[most]{tcolorbox}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.17}
\usetikzlibrary{arrows.meta,calc,patterns}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{multicol}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{titlesec}
\RequirePackage{environ}
\RequirePackage{needspace}
\RequirePackage[hidelinks]{hyperref}

\definecolor{apnavy}{HTML}{16223A}
\definecolor{apblue}{HTML}{2A55D9}
\definecolor{apgold}{HTML}{E0A100}
\definecolor{aptint}{HTML}{EEF2F8}
\definecolor{apgreen}{HTML}{1F6F4A}
\definecolor{apred}{HTML}{C2412D}
\definecolor{apgrey}{HTML}{5B6880}

\newcommand{\coursename}{AP Course}
\newcommand{\unitname}{Unit}
\newcommand{\doctype}{Notes}
\newcommand{\setdoc}[3]{\renewcommand{\coursename}{#1}\renewcommand{\unitname}{#2}\renewcommand{\doctype}{#3}}

\setlength{\parindent}{0pt}
\setlength{\parskip}{5pt}
\setlist{nosep,leftmargin=*,topsep=3pt}

\pagestyle{fancy}\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{apblue}\leaders\hrule height \headrulewidth\hfill}}
\fancyhead[L]{\sffamily\footnotesize\color{apblue}\coursename\ \textbullet\ \unitname}
\fancyhead[R]{\sffamily\footnotesize\color{apgrey}\doctype}
\fancyfoot[C]{\sffamily\footnotesize\color{apgrey}\thepage}
\fancyfoot[R]{\sffamily\scriptsize\color{apgrey}AP Math Tracker}
\fancypagestyle{first}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\fancyfoot[C]{\sffamily\footnotesize\color{apgrey}\thepage}\fancyfoot[R]{\sffamily\scriptsize\color{apgrey}AP Math Tracker}}

% Title band
\newcommand{\titleband}[2]{%
  \thispagestyle{first}%
  \begin{tcolorbox}[enhanced,colback=apnavy,colframe=apnavy,arc=0pt,boxrule=0pt,left=14pt,right=14pt,top=12pt,bottom=12pt,
    overlay={\foreach \i in {0,...,7}{\draw[apblue!60,line width=0.6pt] ([xshift=-12pt-\i*13pt,yshift=-10pt]frame.north east) -- ++(-8pt,-8pt);}}]
  {\sffamily\color{apgold}\bfseries\small \MakeUppercase{\coursename}\par}
  \vspace{2pt}{\sffamily\color{white}\small \unitname\ \textbullet\ \doctype\par}
  \vspace{4pt}{\sffamily\color{white}\bfseries\LARGE #1\par}
  \ifx&#2&\else\vspace{4pt}{\color{white!80!apnavy}\small #2\par}\fi
  \end{tcolorbox}\vspace{4pt}}

% Sections = lessons
\titleformat{\section}{\sffamily\Large\bfseries\color{apnavy}}{\colorbox{apblue}{\color{white}\,\thesection\,}}{8pt}{}
\titlespacing*{\section}{0pt}{14pt}{6pt}
\titleformat{\subsection}{\sffamily\large\bfseries\color{apblue}}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{8pt}{3pt}
\newcommand{\lesson}[2]{\renewcommand{\thesection}{#1}\section{#2}}

% Boxes
\newtcolorbox{keyidea}[1][Key idea]{enhanced,breakable,colback=aptint,colframe=apblue,boxrule=0pt,leftrule=3pt,arc=0pt,
  title={\sffamily\bfseries\small #1},coltitle=apblue,colbacktitle=aptint,attach title to upper={\par},left=8pt,top=4pt,bottom=4pt}
\newtcolorbox{example}[1][Example]{enhanced,breakable,colback=white,colframe=apgrey!40,boxrule=0.5pt,arc=2pt,
  title={\sffamily\bfseries\small #1},coltitle=apnavy,colbacktitle=apgrey!12,left=8pt,top=4pt,bottom=4pt}
\newtcolorbox{aptip}{enhanced,breakable,colback=apgold!10,colframe=apgold,boxrule=0pt,leftrule=3pt,arc=0pt,
  title={\sffamily\bfseries\small AP exam tip},coltitle=apgold!60!black,colbacktitle=apgold!10,attach title to upper={\par},left=8pt,top=4pt,bottom=4pt}
\newcommand{\sol}{\par\textbf{\sffamily\small\color{apgreen}Solution.}\ }

% Exercises with optional solutions
\newif\ifkey
\newcounter{exo}
\newenvironment{exo}[2][]{\refstepcounter{exo}\par\Needspace{12\baselineskip}\medskip
  \noindent{\sffamily\bfseries\color{apnavy}Question \theexo}\ifx&#1&\else\ {\sffamily\small\color{apgrey}(#1)}\fi\hfill\ifx&#2&\nocalc\else#2\fi\par\nopagebreak}{\par}
\newcommand{\easy}{$\star$}\newcommand{\medium}{$\star\star$}\newcommand{\hard}{$\star\star\star$}
\NewEnviron{solution}{\ifkey\begin{tcolorbox}[enhanced,breakable,colback=apgreen!6,colframe=apgreen,boxrule=0pt,leftrule=2.5pt,arc=0pt,left=8pt,top=3pt,bottom=3pt]{\sffamily\bfseries\small\color{apgreen}Solution}\par\BODY\end{tcolorbox}\fi}
\newcommand{\partheading}[1]{\par\bigskip{\sffamily\bfseries\large\color{apnavy}\colorbox{apgold}{\,#1\,}}\par\smallskip}

% Multiple choice: one answer choice per line
\newcommand{\choices}[4]{\par\smallskip
  \begin{tabular}{@{}l@{\hspace{6pt}}p{0.86\linewidth}@{}}(A)&#1\\[3pt](B)&#2\\[3pt](C)&#3\\[3pt](D)&#4\end{tabular}\par}
\newcommand{\answer}[2]{\begin{solution}\textbf{Answer: (#1).} #2\end{solution}}
% Calculator labels (second argument of exo)
\newcommand{\nocalc}{\tcbox[on line,colback=apgrey!14,colframe=apgrey!14,boxrule=0pt,arc=2pt,left=4pt,right=4pt,top=1.5pt,bottom=1.5pt]{\sffamily\scriptsize\bfseries\color{apgrey}NO CALCULATOR}}
\newcommand{\calcreq}{\tcbox[on line,colback=apblue,colframe=apblue,boxrule=0pt,arc=2pt,left=4pt,right=4pt,top=1.5pt,bottom=1.5pt]{\sffamily\scriptsize\bfseries\color{white}CALCULATOR}}
% Directions box
\newtcolorbox{directions}[1][Directions]{enhanced,breakable,colback=white,colframe=apnavy,boxrule=0.6pt,arc=0pt,
  title={\sffamily\bfseries\small #1},colbacktitle=apnavy,coltitle=white,left=8pt,top=4pt,bottom=4pt,fontupper=\small}
\pgfplotsset{gridaxis/.style={apaxis,xtick distance=1,ytick distance=1,minor tick num=0}}

% Graph helpers
\pgfplotsset{apaxis/.style={axis lines=middle,grid=both,grid style={line width=.1pt,draw=apgrey!25},major grid style={line width=.2pt,draw=apgrey!40},
  xlabel={$x$},ylabel={$y$},every axis x label/.style={at={(ticklabel* cs:1)},anchor=west},every axis y label/.style={at={(ticklabel* cs:1)},anchor=south},
  tick label style={font=\scriptsize},width=7cm,height=5.5cm,samples=150,clip=true}}

% plain-text calculator labels for running text (badges overlap lines)
\newcommand{\nocalctext}{\textsf{\footnotesize\bfseries NO CALCULATOR}}
\newcommand{\calctext}{\textsf{\footnotesize\bfseries\color{apblue}CALCULATOR}}

% ---------- Guided notes: blanks for students, answers in the filled version (\keytrue) ----------
\newlength\fillw
\newcommand{\fillin}[1]{\settowidth{\fillw}{#1}\addtolength{\fillw}{1.4em}%
  \ifkey\underline{\makebox[\fillw]{\textcolor{apblue}{#1}}}\else\underline{\makebox[\fillw]{\vphantom{#1}}}\fi}
% work space: an empty box for students, the worked solution in the filled version
\NewEnviron{workspace}[1][3.2cm]{\ifkey
  \begin{tcolorbox}[enhanced,breakable,colback=apblue!4,colframe=apblue!50,boxrule=0.4pt,arc=2pt,left=6pt,top=3pt,bottom=3pt]\color{apnavy}\BODY\end{tcolorbox}%
  \else\begin{tcolorbox}[enhanced,colback=white,colframe=apgrey!45,boxrule=0.4pt,arc=2pt,height=#1]\end{tcolorbox}\fi}
\newcommand{\goals}[1]{\begin{keyidea}[Learning goals]\begin{itemize}#1\end{itemize}\end{keyidea}}
\newcommand{\vocab}[1]{\par\textsf{\bfseries\small\color{apnavy}Vocabulary.}\ #1\par}
\newtcolorbox{mistakes}{enhanced,breakable,colback=apred!5,colframe=apred,boxrule=0pt,leftrule=3pt,arc=0pt,
  title={\sffamily\bfseries\small Common mistakes},coltitle=apred,colbacktitle=apred!5,attach title to upper={\par},left=8pt,top=4pt,bottom=4pt}
\newtcolorbox{quickcheck}{enhanced,breakable,colback=white,colframe=apnavy,boxrule=0.6pt,arc=0pt,
  title={\sffamily\bfseries\small Check your understanding},colbacktitle=apnavy,coltitle=white,left=8pt,top=4pt,bottom=4pt}
\newcommand{\ex}[1]{\par\Needspace{9\baselineskip}\medskip\noindent{\sffamily\bfseries\small\color{apnavy}#1}\par\nopagebreak}

% ---------- SAT: student-produced response (grid-in) ----------
% \spr{shown answer}{accepted values separated by |}{explanation}
\newcommand{\spr}[3]{\ifkey\else\par\smallskip{\sffamily\small\color{apgrey}Your answer:}\ \rule{3.6cm}{0.4pt}\par\fi\begin{solution}\textbf{Answer: #1.} #3\end{solution}}
\newcommand{\sprtag}{\tcbox[on line,colback=apgold!25,colframe=apgold!25,boxrule=0pt,arc=2pt,left=4pt,right=4pt,top=1.5pt,bottom=1.5pt]{\sffamily\scriptsize\bfseries\color{apnavy}STUDENT-PRODUCED RESPONSE}}
\endinput
